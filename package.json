{
  "name": "@jiang_quan_ming/react-code-diff",
  "private": false,
  "version": "1.2.0",
  "description": "A React component for rendering GitHub-style code diffs with syntax highlighting, inline diff, search, split/unified views and more.",
  "type": "module",
  "license": "MIT",
  "author": "quanming1",
  "keywords": [
    "react",
    "diff",
    "code-diff",
    "syntax-highlighting",
    "refractor",
    "split-view",
    "unified-view",
    "component",
    "github-diff"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/quanming1/react-code-diff.git"
  },
  "homepage": "https://github.com/quanming1/react-code-diff",
  "bugs": {
    "url": "https://github.com/quanming1/react-code-diff/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "diff": "8.0.3",
    "lucide-react": "^1.25.0",
    "refractor": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
