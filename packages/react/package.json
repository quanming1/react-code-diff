{
  "name": "@cd/react",
  "version": "0.1.0",
  "private": true,
  "description": "@cd/react —— 对外 React 集成（CodeDiff + CodeEditor + 模型注册表 + 诊断 API），依赖 @cd/view",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project react"
  },
  "dependencies": {
    "@cd/core": "workspace:*",
    "@cd/tokenizer": "workspace:*",
    "@cd/view": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
